          "global_prompt": "Cinematic continuity, stable primary character identity, coherent lighting and environment across the complete sequence.",
          "director_json": "{\"version\":1,\"kind\":\"h3_longmedia_director\",\"fps\":24.0,\"subjects\":[{\"subject_id\":\"subject-picture-1\",\"name\":\"Primary character\",\"kind\":\"Picture\",\"slot\":1,\"description\":\"The primary character identity and appearance reference used consistently across the complete sequence.\",\"retention\":\"fully_preserved\"}],\"shots\":[{\"clip_id\":\"director-shot-1\",\"name\":\"Arrival\",\"prompt\":\"The primary character enters the scene and walks forward with a calm, deliberate pace. The environment remains visually coherent and establishes the location for the continuous sequence.\",\"duration\":5.0,\"seed\":null,\"subjects\":[\"subject-picture-1\"],\"audio\":{\"diegetic\":\"\",\"music\":\"\",\"reactive\":\"\"},\"camera\":{\"shot_size\":\"Wide Shot\",\"rig\":\"3-Axis Gimbal\",\"camera_body\":\"Cinematic Neutral\",\"lens\":\"Auto / Native Lens\",\"stabilization\":\"Gimbal Smooth\",\"movement\":\"Track Forward\",\"speed\":\"Slow\",\"transition_type\":\"Continuous / Same Shot\",\"space_relation\":\"Same Space\",\"entity_continuity\":\"Lock Population / Layout\",\"transition_to_next\":true}},{\"clip_id\":\"director-shot-2\",\"name\":\"Approach\",\"prompt\":\"The same character continues forward through the same space and gradually turns attention toward the camera while the surrounding scene develops naturally.\",\"duration\":5.0,\"seed\":null,\"subjects\":[\"subject-picture-1\"],\"audio\":{\"diegetic\":\"\",\"music\":\"\",\"reactive\":\"\"},\"camera\":{\"shot_size\":\"Medium Shot\",\"rig\":\"3-Axis Gimbal\",\"camera_body\":\"Cinematic Neutral\",\"lens\":\"Auto / Native Lens\",\"stabilization\":\"Gimbal Smooth\",\"movement\":\"Track Forward\",\"speed\":\"Controlled\",\"transition_type\":\"Continuous / Same Shot\",\"space_relation\":\"Same Space\",\"entity_continuity\":\"Lock Population / Layout\",\"transition_to_next\":true}},{\"clip_id\":\"director-shot-3\",\"name\":\"Reveal\",\"prompt\":\"The character reaches the visual focal point and pauses as finer environmental details become prominent, completing the continuous movement with a composed final moment.\",\"duration\":5.0,\"seed\":null,\"subjects\":[\"subject-picture-1\"],\"audio\":{\"diegetic\":\"\",\"music\":\"\",\"reactive\":\"\"},\"camera\":{\"shot_size\":\"Medium Close-Up\",\"rig\":\"3-Axis Gimbal\",\"camera_body\":\"Cinematic Neutral\",\"lens\":\"Auto / Native Lens\",\"stabilization\":\"Gimbal Smooth\",\"movement\":\"Push-In\",\"speed\":\"Ultra Slow\",\"transition_type\":\"Continuous / Same Shot\",\"space_relation\":\"Same Space\",\"entity_continuity\":\"Lock Population / Layout\",\"transition_to_next\":false}}]}"
